{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "english-coach-bot",
  "projectType": "application",
  "root": ".",
  "sourceRoot": ".",
  "tags": [
    "type:backend",
    "lang:go",
    "app:telegram-bot"
  ],
  "implicitDependencies": [
    "web-static"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -ldflags \"-s -w\" -o aibot .",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/aibot"
      ]
    },
    "web-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm --prefix web-react run build",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/web/v2/index.html",
        "{workspaceRoot}/web/v2/assets"
      ]
    },
    "web-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm --prefix web-react run dev",
        "cwd": "."
      }
    },
    "site-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm --prefix site-react run build",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/Сайт полиглота для бота/poliglot-ai.html",
        "{workspaceRoot}/Сайт полиглота для бота/privacy.html",
        "{workspaceRoot}/Сайт полиглота для бота/terms.html",
        "{workspaceRoot}/Сайт полиглота для бота/assets/site-react"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run_go_tests_local_vocab.mjs",
        "cwd": "."
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/run_go_tests_local_vocab.mjs",
          "node tools/check_encoding_artifacts.mjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "generate-activation-keys": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/generate_activation_keys.mjs",
        "cwd": "."
      }
    },
    "rebuild-public-translations": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/rebuild_public_site_translations.mjs",
        "cwd": "."
      }
    }
  }
}
