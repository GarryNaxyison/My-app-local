[Unit]
Description=NERIVA website and OpenRouter chat
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/neriva.ru
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /var/www/neriva.ru/server.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
